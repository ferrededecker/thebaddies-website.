# Copy these into your hosting provider's Environment settings.
NODE_ENV=production
BASE_URL=https://your-site.example
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret
MOLLIE_API_KEY=test_replace_with_your_mollie_test_key
# Optional: directory on your persistent disk. On Render, set to /var/data
DATA_DIR=./data
PORT=3000
